# In .env.local kopieren und anpassen
DATABASE_URL=postgres://festival:festival@localhost:5432/festival
# Gehostete DBs (Neon, Supabase, ...): ?sslmode=require einfach dranlassen –
# die App übersetzt das selbst in eine explizite TLS-Config (keine pg-Warnung).
#   DATABASE_URL=postgres://...?sslmode=require
#   DATABASE_SSL=no-verify   # nur falls das Zertifikat nicht verifizierbar ist
# Öffentliche Basis-URL für SEO (Canonical/OpenGraph/Sitemap/robots.txt).
# In Produktion auf die echte Domain setzen, sonst greift localhost.
# Achtung: wird beim `next build` eingebacken – muss also zur Build-Zeit
# gesetzt sein (in .env.local reicht, die lädt Next auch beim Build).
#   APP_URL=https://buddy.example.com
# Festival-Daten pflegen Veranstalter in der App (/veranstalter); ihre
# Einladungscodes erzeugt der Betreiber per `npm run organizer -- generate <id>`.
# Ein Admin-Passwort gibt es nicht mehr.
# Web Push (Mitteilungen & Band-Erinnerungen): Schlüsselpaar einmalig
# erzeugen mit `npx web-push generate-vapid-keys`. Ohne diese drei Variablen
# ist Push einfach aus – Mitteilungen erscheinen dann nur in der App.
#   VAPID_PUBLIC_KEY=...
#   VAPID_PRIVATE_KEY=...
#   VAPID_SUBJECT=mailto:kontakt@example.com
# Schützt /api/cron/reminders (Band-Erinnerungen, alle 5 Min. per
# vercel.json-Cron; Vercel schickt den Wert automatisch als Bearer-Token).
# Achtung: Der Vercel-Hobby-Plan erlaubt nur tägliche Crons – dann einen
# externen Dienst (z. B. cron-job.org) alle 5 Min. mit
# `Authorization: Bearer <CRON_SECRET>` auf die Route zeigen lassen.
#   CRON_SECRET=...
